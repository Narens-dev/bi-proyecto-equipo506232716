<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t_dim_ruta</name>
    <description>Carga dim_ruta con los códigos de F1 y el nombre de troncal de F3</description>
    <extended_description/>
    <trans_version>2.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>

    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <created_user>Equipo 506232716</created_user>
    <created_date>2026/11/06 20:00:00.000</created_date>
    <modified_user>Equipo 506232716</modified_user>
    <modified_date>2026/11/06 20:00:00.000</modified_date>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>

  </notepads>
  <connection>
    <name>dw_movibogota</name>
    <server>${DW_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username>${DW_USER}</username>
    <password>${DW_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DW_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>F1 CSV validaciones</from><to>selecciona_ruta</to><enabled>Y</enabled></hop>
    <hop><from>selecciona_ruta</from><to>rutas_unicas</to><enabled>Y</enabled></hop>
    <hop><from>rutas_unicas</from><to>deriva_codigo_ruta</to><enabled>Y</enabled></hop>
    <hop><from>deriva_codigo_ruta</from><to>busca_troncal_F3</to><enabled>Y</enabled></hop>
    <hop><from>regla_estandariza_nombres_troncal</from><to>troncales_unicas_F3</to><enabled>Y</enabled></hop>
    <hop><from>troncales_unicas_F3</from><to>busca_troncal_F3</to><enabled>Y</enabled></hop>
    <hop><from>busca_troncal_F3</from><to>carga_dim_ruta</to><enabled>Y</enabled></hop>
    <hop><from>F3 JSON trazados</from><to>regla_estandariza_nombres_troncal</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>F1 CSV validaciones</name>
    <type>CsvInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${Internal.Entry.Current.Directory}/../../datos/raw/Dataset_registros.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>id_validacion</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>fecha_hora</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_estacion</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_ruta</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_bus</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>tipo_tarifa</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>monto_pagado</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>metodo_pago</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>selecciona_ruta</name>
    <type>SelectValues</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>id_ruta</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>300</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>rutas_unicas</name>
    <type>UniqueRowsByHashSet</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description></error_description>
    <fields><field><name>id_ruta</name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>500</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>deriva_codigo_ruta</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// RUTA-B12 -&gt; B12; la letra identifica la troncal (le_troncal de F3)
var cod_ruta = ('' + id_ruta).replace(/^\s+|\s+$/g, '').toUpperCase().replace('RUTA-', '');
var letra_troncal = cod_ruta.charAt(0);
var tipo_servicio = 'Troncal';</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>cod_ruta</name><rename>cod_ruta</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>letra_troncal</name><rename>letra_troncal</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>tipo_servicio</name><rename>tipo_servicio</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>700</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>troncales_unicas_F3</name>
    <type>UniqueRowsByHashSet</type>
    <description>Varias filas de F3 comparten troncal: se conserva una por letra</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description></error_description>
    <fields><field><name>le_troncal</name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>500</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>busca_troncal_F3</name>
    <type>StreamLookup</type>
    <description>Integra F1 con F3 por letra de troncal</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>troncales_unicas_F3</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup><key><name>letra_troncal</name><field>le_troncal</field></key><value><name>nom_tronc</name><rename>nombre_troncal</rename><default>Desconocida</default><type>String</type></value></lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>900</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>carga_dim_ruta</name>
    <type>TableOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_movibogota</connection>
    <schema>dw</schema>
    <table>dim_ruta</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>cod_ruta</column_name><stream_name>cod_ruta</stream_name></field>
      <field><column_name>letra_troncal</column_name><stream_name>letra_troncal</stream_name></field>
      <field><column_name>nombre_troncal</column_name><stream_name>nombre_troncal</stream_name></field>
      <field><column_name>tipo_servicio</column_name><stream_name>tipo_servicio</stream_name></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>F3 JSON trazados</name>
    <type>JsonInput</type>
    <description>Lee el GeoJSON original de Trazados Troncales de TRANSMILENIO</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name>${Internal.Entry.Current.Directory}/../../datos/raw/Trazados_Troncales_de_TRANSMILENIO.geojson</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field><name>id_trazado</name><path>$.features[*].properties.id_trazado</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>nom_traz</name><path>$.features[*].properties.nom_traz</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>le_troncal</name><path>$.features[*].properties.le_troncal</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
      <field><name>nom_tronc</name><path>$.features[*].properties.nom_tronc</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field>
    </fields>
    <limit>0</limit>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField/>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_estandariza_nombres_troncal</name>
    <type>ScriptValueMod</type>
    <description>Corrige tildes y mayúsculas en nombres de F3</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// F3: nombres de trazados y troncales sin tildes y con mayúsculas inconsistentes
function corrige(t) {
  if (t == null) return t;
  var s = ('' + t).replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
  var dic = { 'Americas': 'Américas', 'Eldorado': 'El Dorado', 'ElDorado': 'El Dorado',
              'Extension': 'Extensión', 'Limite': 'Límite', 'Cali': 'Cali' };
  for (var k in dic) { s = s.replace(new RegExp('\\b' + k + '\\b', 'g'), dic[k]); }
  s = s.replace(/ De /g, ' de ').replace(/ Del /g, ' del ');
  return s;
}
nom_traz = corrige(nom_traz);
nom_tronc = corrige(nom_tronc);
le_troncal = ('' + le_troncal).replace(/^\s+|\s+$/g, '').toUpperCase();</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>nom_traz</name><rename>nom_traz</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>nom_tronc</name><rename>nom_tronc</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>le_troncal</name><rename>le_troncal</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>300</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling>

  </step_error_handling>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
