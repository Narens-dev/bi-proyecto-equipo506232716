      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DW_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>F1 CSV validaciones</from><to>regla_elimina_duplicados</to><enabled>Y</enabled></hop>
    <hop><from>regla_elimina_duplicados</from><to>fecha_es_iso</to><enabled>Y</enabled></hop>
    <hop><from>fecha_es_iso</from><to>convierte_fecha_iso</to><enabled>Y</enabled></hop>
    <hop><from>fecha_es_iso</from><to>fecha_es_epoch</to><enabled>Y</enabled></hop>
    <hop><from>fecha_es_epoch</from><to>regla_normaliza_fecha_epoch</to><enabled>Y</enabled></hop>
    <hop><from>fecha_es_epoch</from><to>regla_normaliza_fecha_ampm</to><enabled>Y</enabled></hop>
    <hop><from>convierte_fecha_iso</from><to>fechas_normalizadas</to><enabled>Y</enabled></hop>
    <hop><from>regla_normaliza_fecha_epoch</from><to>fechas_normalizadas</to><enabled>Y</enabled></hop>
    <hop><from>regla_normaliza_fecha_ampm</from><to>fechas_normalizadas</to><enabled>Y</enabled></hop>
    <hop><from>fechas_normalizadas</from><to>codigo_estacion_limpio</to><enabled>Y</enabled></hop>
    <hop><from>codigo_estacion_limpio</from><to>codigos_normalizados</to><enabled>Y</enabled></hop>
    <hop><from>codigo_estacion_limpio</from><to>regla_normaliza_codigo_estacion</to><enabled>Y</enabled></hop>
    <hop><from>regla_normaliza_codigo_estacion</from><to>codigos_normalizados</to><enabled>Y</enabled></hop>
    <hop><from>codigos_normalizados</from><to>bus_informado</to><enabled>Y</enabled></hop>
    <hop><from>bus_informado</from><to>buses_normalizados</to><enabled>Y</enabled></hop>
    <hop><from>bus_informado</from><to>regla_bus_vacio_a_desconocido</to><enabled>Y</enabled></hop>
    <hop><from>regla_bus_vacio_a_desconocido</from><to>buses_normalizados</to><enabled>Y</enabled></hop>
    <hop><from>buses_normalizados</from><to>deriva_llaves_naturales</to><enabled>Y</enabled></hop>
    <hop><from>deriva_llaves_naturales</from><to>regla_valida_monto_positivo</to><enabled>Y</enabled></hop>
    <hop><from>regla_valida_monto_positivo</from><to>lookup_dim_estacion</to><enabled>Y</enabled></hop>
    <hop><from>regla_valida_monto_positivo</from><to>rechazos_monto</to><enabled>Y</enabled></hop>
    <hop><from>lookup_dim_estacion</from><to>estacion_encontrada</to><enabled>Y</enabled></hop>
    <hop><from>estacion_encontrada</from><to>estaciones_resueltas</to><enabled>Y</enabled></hop>
    <hop><from>estacion_encontrada</from><to>regla_estacion_desconocida</to><enabled>Y</enabled></hop>
    <hop><from>regla_estacion_desconocida</from><to>estaciones_resueltas</to><enabled>Y</enabled></hop>
    <hop><from>estaciones_resueltas</from><to>lookup_dim_ruta</to><enabled>Y</enabled></hop>
    <hop><from>lookup_dim_ruta</from><to>lookup_dim_tarifa</to><enabled>Y</enabled></hop>
    <hop><from>lookup_dim_tarifa</from><to>lookup_dim_bus</to><enabled>Y</enabled></hop>
    <hop><from>lookup_dim_bus</from><to>carga_fact_validaciones</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>F1 CSV validaciones</name>
    <type>CsvInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${Internal.Entry.Current.Directory}/../../datos/raw/Dataset_registros.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>Lee el CSV original de validaciones</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>id_validacion</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>fecha_hora</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_estacion</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_ruta</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>id_bus</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>tipo_tarifa</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>monto_pagado</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>metodo_pago</name><type>String</type><format></format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_elimina_duplicados</name>
    <type>UniqueRowsByHashSet</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>Y</reject_duplicate_row>
    <error_description>Validación duplicada (mismo id_validacion)</error_description>
    <fields><field><name>id_validacion</name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>300</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>rechazos_duplicados</name>
    <type>TextFileOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${Internal.Entry.Current.Directory}/../rechazos/rechazos_duplicados</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>300</xloc><yloc>250</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>fecha_es_iso</name>
    <type>FilterRows</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>convierte_fecha_iso</send_true_to>
    <send_false_to>fecha_es_epoch</send_false_to>
    <compare>
      <condition><negated>N</negated><leftvalue>fecha_hora</leftvalue><function>REGEXP</function><rightvalue/><value><name>constant</name><type>String</type><text>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>500</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>convierte_fecha_iso</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// aaaa-mm-dd hh:mm:ss
var p = ('' + fecha_hora).match(/^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})$/);
var Y = parseInt(p[1], 10), M = parseInt(p[2], 10), D = parseInt(p[3], 10);
var h = parseInt(p[4], 10), mi = parseInt(p[5], 10), s = parseInt(p[6], 10);
var fecha_hora_dt = new Date(Y, M - 1, D, h, mi, s);
var sk_tiempo = Y * 10000 + M * 100 + D;
var sk_hora = h * 60 + mi;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>fecha_hora_dt</name><rename>fecha_hora_dt</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_tiempo</name><rename>sk_tiempo</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_hora</name><rename>sk_hora</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>700</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>fecha_es_epoch</name>
    <type>FilterRows</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>regla_normaliza_fecha_epoch</send_true_to>
    <send_false_to>regla_normaliza_fecha_ampm</send_false_to>
    <compare>
      <condition><negated>N</negated><leftvalue>fecha_hora</leftvalue><function>REGEXP</function><rightvalue/><value><name>constant</name><type>String</type><text>\d{9,10}</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>500</xloc><yloc>250</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_normaliza_fecha_epoch</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// epoch Unix (segundos UTC) -&gt; hora local de Bogotá (UTC-5)
var e = parseInt('' + fecha_hora, 10);
var u = new Date((e - 5 * 3600) * 1000);
var Y = u.getUTCFullYear(), M = u.getUTCMonth() + 1, D = u.getUTCDate();
var h = u.getUTCHours(), mi = u.getUTCMinutes(), s = u.getUTCSeconds();
var fecha_hora_dt = new Date(Y, M - 1, D, h, mi, s);
var sk_tiempo = Y * 10000 + M * 100 + D;
var sk_hora = h * 60 + mi;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>fecha_hora_dt</name><rename>fecha_hora_dt</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_tiempo</name><rename>sk_tiempo</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_hora</name><rename>sk_hora</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>700</xloc><yloc>250</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_normaliza_fecha_ampm</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// dd/mm/aaaa hh:mm AM|PM (reloj de 12 horas)
var p = ('' + fecha_hora).match(/^(\d{2})\/(\d{2})\/(\d{4}) (\d{2}):(\d{2}) (AM|PM)$/);
var D = parseInt(p[1], 10), M = parseInt(p[2], 10), Y = parseInt(p[3], 10);
var h = parseInt(p[4], 10), mi = parseInt(p[5], 10), s = 0;
if (p[6] == 'PM' &amp;&amp; h &lt; 12) h += 12;
if (p[6] == 'AM' &amp;&amp; h == 12) h = 0;
var fecha_hora_dt = new Date(Y, M - 1, D, h, mi, s);
var sk_tiempo = Y * 10000 + M * 100 + D;
var sk_hora = h * 60 + mi;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>fecha_hora_dt</name><rename>fecha_hora_dt</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_tiempo</name><rename>sk_tiempo</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>sk_hora</name><rename>sk_hora</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>700</xloc><yloc>400</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>fechas_normalizadas</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>

    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>900</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>codigo_estacion_limpio</name>
    <type>FilterRows</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>codigos_normalizados</send_true_to>
    <send_false_to>regla_normaliza_codigo_estacion</send_false_to>
    <compare>
      <condition><negated>N</negated><leftvalue>id_estacion</leftvalue><function>REGEXP</function><rightvalue/><value><name>constant</name><type>String</type><text>EST-\d{5}</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_normaliza_codigo_estacion</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// '  est-07103 ' -&gt; 'EST-07103'
id_estacion = ('' + id_estacion).replace(/^\s+|\s+$/g, '').toUpperCase();</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>id_estacion</name><rename>id_estacion</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1100</xloc><yloc>250</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>codigos_normalizados</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>

    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1300</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>bus_informado</name>
    <type>FilterRows</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>buses_normalizados</send_true_to>
    <send_false_to>regla_bus_vacio_a_desconocido</send_false_to>
    <compare>
      <condition><negated>N</negated><leftvalue>id_bus</leftvalue><function>IS NOT EMPTY</function><rightvalue/></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>1500</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>regla_bus_vacio_a_desconocido</name>
    <type>ScriptValueMod</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// bus no transmitido -&gt; miembro SIN-BUS (llave -1)
id_bus = 'SIN-BUS';</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
