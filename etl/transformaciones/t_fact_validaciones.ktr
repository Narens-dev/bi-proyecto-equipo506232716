        <jsScript_script>var cod_estacion = ('' + id_estacion).replace('EST-', '');
var cod_ruta = ('' + id_ruta).replace(/^\s+|\s+$/g, '').toUpperCase().replace('RUTA-', '');
var monto_num = parseFloat(monto_pagado);
var cantidad = 1;</jsScript_script>
      </jsScript>
