<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t_dim_tiempo</name>
    <description>Puebla la dimensión de tiempo (un registro por día) sin huecos</description>
    <extended_description/>
    <trans_version>2.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter><name>FECHA_INICIO</name><default_value>2024-01-01</default_value><description>Primer día del periodo de los hechos</description></parameter>
      <parameter><name>FECHA_FIN</name><default_value>2025-12-31</default_value><description>Último día del periodo de los hechos</description></parameter>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <created_user>Equipo 506232716</created_user>
    <created_date>2026/11/06 20:00:00.000</created_date>
    <modified_user>Equipo 506232716</modified_user>
    <modified_date>2026/11/06 20:00:00.000</modified_date>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>

  </notepads>
  <connection>
    <name>dw_movibogota</name>
    <server>${DW_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username>${DW_USER}</username>
    <password>${DW_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DW_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>genera_calendario</from><to>carga_dim_tiempo</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>genera_calendario</name>
    <type>TableInput</type>
    <description>Genera un día por fila entre FECHA_INICIO y FECHA_FIN</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_movibogota</connection>
    <sql>SELECT CAST(to_char(d, 'YYYYMMDD') AS INTEGER)              AS sk_tiempo,
       CAST(d AS DATE)                                       AS fecha,
       CAST(EXTRACT(DAY FROM d) AS SMALLINT)                 AS dia,
       CAST(EXTRACT(ISODOW FROM d) AS SMALLINT)              AS dia_semana,
       (ARRAY['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'])[EXTRACT(ISODOW FROM d)] AS nombre_dia,
       EXTRACT(ISODOW FROM d) IN (6, 7)                      AS es_fin_semana,
       CAST(EXTRACT(WEEK FROM d) AS SMALLINT)                AS semana_iso,
       CAST(EXTRACT(MONTH FROM d) AS SMALLINT)               AS mes,
       (ARRAY['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'])[EXTRACT(MONTH FROM d)] AS nombre_mes,
       to_char(d, 'YYYY-MM')                                 AS anio_mes,
       CAST(EXTRACT(QUARTER FROM d) AS SMALLINT)             AS trimestre,
       CAST(CASE WHEN EXTRACT(MONTH FROM d) &lt;= 6 THEN 1 ELSE 2 END AS SMALLINT) AS semestre,
       CAST(EXTRACT(YEAR FROM d) AS SMALLINT)                AS anio
FROM generate_series(DATE '${FECHA_INICIO}', DATE '${FECHA_FIN}', INTERVAL '1 day') AS g(d)
ORDER BY 1
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>carga_dim_tiempo</name>
    <type>TableOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_movibogota</connection>
    <schema>dw</schema>
    <table>dim_tiempo</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>sk_tiempo</column_name><stream_name>sk_tiempo</stream_name></field>
      <field><column_name>fecha</column_name><stream_name>fecha</stream_name></field>
      <field><column_name>dia</column_name><stream_name>dia</stream_name></field>
      <field><column_name>dia_semana</column_name><stream_name>dia_semana</stream_name></field>
      <field><column_name>nombre_dia</column_name><stream_name>nombre_dia</stream_name></field>
      <field><column_name>es_fin_semana</column_name><stream_name>es_fin_semana</stream_name></field>
      <field><column_name>semana_iso</column_name><stream_name>semana_iso</stream_name></field>
      <field><column_name>mes</column_name><stream_name>mes</stream_name></field>
      <field><column_name>nombre_mes</column_name><stream_name>nombre_mes</stream_name></field>
      <field><column_name>anio_mes</column_name><stream_name>anio_mes</stream_name></field>
      <field><column_name>trimestre</column_name><stream_name>trimestre</stream_name></field>
      <field><column_name>semestre</column_name><stream_name>semestre</stream_name></field>
      <field><column_name>anio</column_name><stream_name>anio</stream_name></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>350</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling>

  </step_error_handling>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
