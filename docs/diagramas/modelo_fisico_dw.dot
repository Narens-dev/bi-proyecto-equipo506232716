digraph dw {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.2, fontname="Helvetica", label="Modelo físico MoviBogotá DW (esquema dw, PostgreSQL) - generado desde information_schema", labelloc=t, fontsize=16];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [arrowhead=crow, arrowtail=none, dir=both, color="#555555"];
  dim_bus [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_bus</b></font></td></tr><tr><td align="left" port="sk_bus"><b>PK</b> sk_bus</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="cod_bus">cod_bus</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="numero_bus">numero_bus</td><td align="left"><font color="#555555">smallint</font></td></tr></table>>];
  dim_estacion [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_estacion</b></font></td></tr><tr><td align="left" port="sk_estacion"><b>PK</b> sk_estacion</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="cod_estacion">cod_estacion</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="nombre_estacion">nombre_estacion</td><td align="left"><font color="#555555">varchar(80)</font></td></tr><tr><td align="left" port="ubicacion">ubicacion</td><td align="left"><font color="#555555">varchar(80)</font></td></tr><tr><td align="left" port="tipo_estacion">tipo_estacion</td><td align="left"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="num_vagones">num_vagones</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="num_accesos">num_accesos</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="capacidad_biart">capacidad_biart</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="capacidad_art">capacidad_art</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="area_m2">area_m2</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left" port="latitud">latitud</td><td align="left"><font color="#555555">numeric(10,7)</font></td></tr><tr><td align="left" port="longitud">longitud</td><td align="left"><font color="#555555">numeric(10,7)</font></td></tr><tr><td align="left" port="id_trazado">id_trazado</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="nombre_trazado">nombre_trazado</td><td align="left"><font color="#555555">varchar(80)</font></td></tr><tr><td align="left" port="letra_troncal">letra_troncal</td><td align="left"><font color="#555555">varchar(3)</font></td></tr><tr><td align="left" port="nombre_troncal">nombre_troncal</td><td align="left"><font color="#555555">varchar(60)</font></td></tr></table>>];
  dim_hora [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_hora</b></font></td></tr><tr><td align="left" port="sk_hora"><b>PK</b> sk_hora</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="hora_minuto">hora_minuto</td><td align="left"><font color="#555555">time</font></td></tr><tr><td align="left" port="hora">hora</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="minuto">minuto</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="franja_horaria">franja_horaria</td><td align="left"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="orden_franja">orden_franja</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="es_hora_pico">es_hora_pico</td><td align="left"><font color="#555555">boolean</font></td></tr></table>>];
  dim_ruta [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_ruta</b></font></td></tr><tr><td align="left" port="sk_ruta"><b>PK</b> sk_ruta</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="cod_ruta">cod_ruta</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="letra_troncal">letra_troncal</td><td align="left"><font color="#555555">varchar(3)</font></td></tr><tr><td align="left" port="nombre_troncal">nombre_troncal</td><td align="left"><font color="#555555">varchar(60)</font></td></tr><tr><td align="left" port="tipo_servicio">tipo_servicio</td><td align="left"><font color="#555555">varchar(20)</font></td></tr></table>>];
  dim_tarifa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_tarifa</b></font></td></tr><tr><td align="left" port="sk_tarifa"><b>PK</b> sk_tarifa</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="tipo_tarifa">tipo_tarifa</td><td align="left"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="grupo_tarifa">grupo_tarifa</td><td align="left"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="metodo_pago">metodo_pago</td><td align="left"><font color="#555555">varchar(25)</font></td></tr></table>>];
  dim_tiempo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1F6F8B"><font color="white"><b>dw.dim_tiempo</b></font></td></tr><tr><td align="left" port="sk_tiempo"><b>PK</b> sk_tiempo</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="fecha">fecha</td><td align="left"><font color="#555555">date</font></td></tr><tr><td align="left" port="dia">dia</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="dia_semana">dia_semana</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="nombre_dia">nombre_dia</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="es_fin_semana">es_fin_semana</td><td align="left"><font color="#555555">boolean</font></td></tr><tr><td align="left" port="semana_iso">semana_iso</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="mes">mes</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="nombre_mes">nombre_mes</td><td align="left"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="anio_mes">anio_mes</td><td align="left"><font color="#555555">char(7)</font></td></tr><tr><td align="left" port="trimestre">trimestre</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="semestre">semestre</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="anio">anio</td><td align="left"><font color="#555555">smallint</font></td></tr></table>>];
  fact_validaciones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#0E3A5A"><font color="white"><b>dw.fact_validaciones</b></font></td></tr><tr><td align="left" port="id_validacion"><b>PK</b> id_validacion</td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left" port="cod_validacion">cod_validacion</td><td align="left"><font color="#555555">varchar(15)</font></td></tr><tr><td align="left" port="sk_tiempo"><i>FK</i> sk_tiempo</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="sk_hora"><i>FK</i> sk_hora</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="sk_estacion"><i>FK</i> sk_estacion</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="sk_ruta"><i>FK</i> sk_ruta</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="sk_bus"><i>FK</i> sk_bus</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="sk_tarifa"><i>FK</i> sk_tarifa</td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="fecha_hora">fecha_hora</td><td align="left"><font color="#555555">timestamp</font></td></tr><tr><td align="left" port="cantidad_validaciones">cantidad_validaciones</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="monto_pagado">monto_pagado</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr></table>>];
  dim_bus -> fact_validaciones [arrowtail=tee, arrowhead=crow, label="sk_bus", fontsize=9, fontname="Helvetica"];
  fact_validaciones -> dim_estacion [dir=both, arrowtail=crow, arrowhead=tee, label="sk_estacion", fontsize=9, fontname="Helvetica"];
  dim_hora -> fact_validaciones [arrowtail=tee, arrowhead=crow, label="sk_hora", fontsize=9, fontname="Helvetica"];
  fact_validaciones -> dim_ruta [dir=both, arrowtail=crow, arrowhead=tee, label="sk_ruta", fontsize=9, fontname="Helvetica"];
  dim_tarifa -> fact_validaciones [arrowtail=tee, arrowhead=crow, label="sk_tarifa", fontsize=9, fontname="Helvetica"];
  fact_validaciones -> dim_tiempo [dir=both, arrowtail=crow, arrowhead=tee, label="sk_tiempo", fontsize=9, fontname="Helvetica"];
}